# Server-only variables. Do NOT prefix with NEXT_PUBLIC_.
# These are read only in Route Handlers / server code and must never reach the browser bundle.

# Local engine. Production must be https://<allowlisted-host> (see AURA_API_URL_ALLOWED_HOSTS).
AURA_API_URL=http://127.0.0.1:8000

# Local-dev-only-not-for-production. Generate a real secret on Render and copy it to Vercel.
AURA_API_SECRET=local-dev-only-not-for-production

# Optional. Comma-separated hosts allowed for AURA_API_URL outside loopback.
# Defaults to aura-workspace-api.onrender.com if unset.
# AURA_API_URL_ALLOWED_HOSTS=aura-workspace-api.onrender.com
